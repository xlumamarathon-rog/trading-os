# Copy to .env and fill. NEVER commit .env. (Spec §0 rule 4)
INDIA_BROKER_API_KEY=
INDIA_BROKER_SECRET=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Shared secret the Linux core sends as the X-MT5-Auth header to the MT5 exec
# service. SET THIS IN PRODUCTION — unset, the order/close endpoints accept any
# caller that can reach the port. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
MT5_SERVICE_TOKEN=
KILL_SWITCH_UNLOCK_PHRASE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
